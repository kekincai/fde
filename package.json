{
  "name": "fde-radar",
  "version": "0.1.0",
  "private": true,
  "description": "AI Forward Deployed Engineering の公式シグナルを集約する日本語レーダー",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-strip-types --test worker/*.test.ts",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --local --file=./migrations/0002_seed.sql"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tabler/icons-react": "^3.46.0",
    "astro": "^7.2.0",
    "fast-xml-parser": "^5.2.5",
    "hono": "^4.7.8",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.20.0"
  }
}
