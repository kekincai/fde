---
import RadarApp from '../components/RadarApp';
import '../styles/app.css';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="FDE RADARは、AI導入に関する公式発表・導入事例・制度・求人などの一次情報を収集し、FDEの観点と優先度で分類して並べる日本語サイトです。" />
    <meta property="og:title" content="FDE RADAR — AI導入の一次情報を集約" />
    <meta property="og:description" content="日本とグローバルのAI導入に関する一次情報を、6時間ごとに収集・分類。" />
    <meta property="og:image" content="/ai-fde-mark-512.png" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="color-scheme" content="light" />
    <script is:inline>
      // Vertical multi-column text only where it renders reliably (current Chrome, Safari 17.4+, Firefox).
      if (window.CSS && CSS.supports('writing-mode', 'vertical-rl') && CSS.supports('column-fill', 'auto') && CSS.supports('text-wrap', 'balance')) document.documentElement.classList.add('tate-ok');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@500;700;900&family=Yuji+Syuku&display=swap" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>ＦＤＥレーダー — AI導入の一次情報を集約</title>
  </head>
  <body>
    <RadarApp client:load />
  </body>
</html>
